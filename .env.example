# --- Obrigatórias ---------------------------------------------------------
# Token do bot (Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
CLIENT_ID=
# Chave da API da Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=

# --- Opcionais ------------------------------------------------------------
# Registra os slash commands só neste servidor (aparecem na hora). Sem isso, são globais.
# GUILD_ID=
# Limite de iterações do loop agêntico (cada iteração = uma chamada ao Claude)
# MAX_PLAN_ITERATIONS=8
# MAX_EXEC_ITERATIONS=40
# Pausa (ms) entre ações no Discord, para respeitar os rate limits
# ACTION_DELAY_MS=400
# Tempo (ms) para confirmar o plano
# CONFIRM_TIMEOUT_MS=300000
# Arquivo de log das ações (JSON por linha)
# LOG_FILE=logs/actions.log
